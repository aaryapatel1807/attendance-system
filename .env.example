# Root env example — copy to .env and fill in real values.
# Used by server/ (Express) and ai-service/ (FastAPI).

# Express
PORT=5000
MONGO_URI=mongodb://localhost:27017/face_attendance
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# FastAPI ai-service (shared secret for server → ai-service calls)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=change-this-shared-secret
